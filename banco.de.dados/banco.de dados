-- Trigger para atualizar timestamp do estoque
CREATE OR REPLACE FUNCTION fn_atualiza_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW.data_atualizacao = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_estoque_timestamp
BEFORE UPDATE ON estoque
FOR EACH ROW
EXECUTE FUNCTION fn_atualiza_timestamp();

-- Trigger de alerta quando estoque cai abaixo do mínimo
CREATE OR REPLACE FUNCTION fn_alerta_estoque_baixo()
RETURNS TRIGGER AS $$
DECLARE
    v_minimo INT;
    v_nome VARCHAR(100);
BEGIN
    SELECT quantidade_minima, nome INTO v_minimo, v_nome
    FROM material WHERE id_material = NEW.id_material;

    IF NEW.quantidade_atual < v_minimo
       AND NEW.quantidade_atual <> OLD.quantidade_atual THEN
        INSERT INTO alerta (id_material, id_setor, tipo, mensagem, nivel)
        VALUES (
            NEW.id_material,
            NEW.id_setor,
            CASE WHEN NEW.quantidade_atual = 0
                 THEN 'Sem estoque'::alerta_tipo
                 ELSE 'Estoque baixo'::alerta_tipo END,
            'O material "' || v_nome || '" está com ' ||
            NEW.quantidade_atual || ' unidades. Mínimo: ' || v_minimo,
            CASE WHEN NEW.quantidade_atual = 0
                 THEN 'Crítico'::alerta_nivel
                 ELSE 'Atenção'::alerta_nivel END
        );
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_alerta_estoque_baixo
AFTER UPDATE ON estoque
FOR EACH ROW
EXECUTE FUNCTION fn_alerta_estoque_baixo();

-- Trigger de baixa automática ao entregar solicitação
CREATE OR REPLACE FUNCTION fn_baixa_estoque()
RETURNS TRIGGER AS $$
BEGIN
    IF NEW.status = 'Entregue' AND OLD.status <> 'Entregue' THEN
        UPDATE estoque
        SET quantidade_atual = quantidade_atual - NEW.quantidade_pedida
        WHERE id_material = NEW.id_material
          AND id_setor = NEW.id_setor;
    END IF;

    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_baixa_estoque
AFTER UPDATE ON solicitacao
FOR EACH ROW
EXECUTE FUNCTION fn_baixa_estoque();

