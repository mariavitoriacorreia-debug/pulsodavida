-- ============================================================
-- VIEWS
-- ============================================================

CREATE VIEW vw_alertas_ativos AS
SELECT a.id_alerta, h.nome AS hospital, s.nome_setor AS setor,
       m.nome AS material, a.tipo, a.nivel, a.mensagem, a.data_alerta
FROM alerta a
JOIN material m ON a.id_material = m.id_material
JOIN setor s ON a.id_setor = s.id_setor
JOIN hospital h ON s.id_hospital = h.id_hospital
WHERE a.resolvido = FALSE
ORDER BY CASE a.nivel
            WHEN 'Crítico' THEN 1
            WHEN 'Atenção' THEN 2
            ELSE 3
         END,
         a.data_alerta DESC;

CREATE VIEW vw_materiais_criticos AS
SELECT e.id_estoque, h.nome AS hospital, s.nome_setor AS setor,
       m.nome AS material, m.categoria,
       e.quantidade_atual, m.quantidade_minima,
       (m.quantidade_minima - e.quantidade_atual) AS reposicao_sugerida
FROM estoque e
JOIN material m ON e.id_material = m.id_material
JOIN setor s ON e.id_setor = s.id_setor
JOIN hospital h ON s.id_hospital = h.id_hospital
WHERE e.quantidade_atual < m.quantidade_minima;

CREATE VIEW vw_solicitacoes_pendentes AS
SELECT s.id_solicitacao, sec.nome_setor, l.codigo_leito,
       u.nome AS solicitante, m.nome AS material,
       s.quantidade_pedida, s.prioridade,
       s.data_solicitacao, s.status, s.observacao
FROM solicitacao s
JOIN setor sec ON s.id_setor = sec.id_setor
LEFT JOIN leito l ON s.id_leito = l.id_leito
JOIN usuario u ON s.id_usuario = u.id_usuario
JOIN material m ON s.id_material = m.id_material
WHERE s.status = 'Pendente'
ORDER BY CASE s.prioridade
            WHEN 'Urgente' THEN 1
            WHEN 'Alta' THEN 2
            WHEN 'Média' THEN 3
            ELSE 4
         END,
         s.data_solicitacao;

CREATE VIEW vw_estoque_geral AS
SELECT h.nome AS hospital, s.nome_setor AS setor,
       m.nome AS material, m.categoria,
       e.quantidade_atual, m.quantidade_minima,
       m.unidade_medida, e.localizacao, e.data_atualizacao
FROM estoque e
JOIN material m ON e.id_material = m.id_material
JOIN setor s ON e.id_setor = s.id_setor
JOIN hospital h ON s.id_hospital = h.id_hospital;

-- ============================================================
-- FUNCTIONS (substituem as PROCEDURES do MySQL)
-- ============================================================

CREATE OR REPLACE FUNCTION sp_solicitar_material(
    p_id_setor INT,
    p_id_leito INT,
    p_id_usuario INT,
    p_id_material INT,
    p_qtd INT,
    p_prioridade prioridade_tipo,
    p_obs TEXT
) RETURNS INT AS $$
DECLARE
    v_id INT;
BEGIN
    INSERT INTO solicitacao
        (id_setor, id_leito, id_usuario, id_material,
         quantidade_pedida, prioridade, observacao)
    VALUES
        (p_id_setor, p_id_leito, p_id_usuario, p_id_material,
         p_qtd, p_prioridade, p_obs)
    RETURNING id_solicitacao INTO v_id;

    RETURN v_id;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION sp_aprovar_solicitacao(
    p_id_solicitacao INT,
    p_status status_tipo
) RETURNS VOID AS $$
BEGIN
    UPDATE solicitacao
    SET status = p_status
    WHERE id_solicitacao = p_id_solicitacao;
END;
$$ LANGUAGE plpgsql;

CREATE OR REPLACE FUNCTION sp_verificar_estoque(p_id_setor INT)
RETURNS TABLE (
    material VARCHAR,
    quantidade_atual INT,
    quantidade_minima INT,
    situacao TEXT
) AS $$
BEGIN
    RETURN QUERY
    SELECT m.nome::VARCHAR,
           e.quantidade_atual,
           m.quantidade_minima,
           CASE
               WHEN e.quantidade_atual = 0 THEN 'SEM ESTOQUE'
               WHEN e.quantidade_atual < m.quantidade_minima THEN 'CRÍTICO'
               ELSE 'OK'
           END::TEXT
    FROM estoque e
    JOIN material m ON e.id_material = m.id_material
    WHERE e.id_setor = p_id_setor;
END;
$$ LANGUAGE plpgsql;

