-- ============================================================
-- SISTEMA DE GESTÃO DE MATERIAIS HOSPITALARES
-- Versão PostgreSQL
-- ============================================================

-- Limpa tudo (cuidado em produção!)
DROP SCHEMA public CASCADE;
CREATE SCHEMA public;

-- ============================================================
-- 1. HOSPITAL
-- ============================================================
CREATE TABLE hospital (
    id_hospital SERIAL PRIMARY KEY,
    nome VARCHAR(120) NOT NULL,
    cnpj VARCHAR(18) UNIQUE,
    endereco VARCHAR(150),
    cidade VARCHAR(60),
    estado VARCHAR(2),
    telefone VARCHAR(20),
    email VARCHAR(100),
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- 2. SETOR
-- ============================================================
CREATE TABLE setor (
    id_setor SERIAL PRIMARY KEY,
    id_hospital INT NOT NULL REFERENCES hospital(id_hospital)
        ON DELETE CASCADE ON UPDATE CASCADE,
    nome_setor VARCHAR(60) NOT NULL,
    tipo VARCHAR(40),
    responsavel VARCHAR(100),
    ramal VARCHAR(20),
    andar VARCHAR(20)
);

-- ============================================================
-- 3. LEITO
-- ============================================================
CREATE TYPE leito_status AS ENUM ('Livre','Ocupado','Manutenção');

CREATE TABLE leito (
    id_leito SERIAL PRIMARY KEY,
    id_setor INT NOT NULL REFERENCES setor(id_setor)
        ON DELETE CASCADE ON UPDATE CASCADE,
    codigo_leito VARCHAR(20) NOT NULL,
    status leito_status DEFAULT 'Livre',
    paciente VARCHAR(100),
    data_ocupacao TIMESTAMP
);

-- ============================================================
-- 4. USUARIO
-- ============================================================
CREATE TABLE usuario (
    id_usuario SERIAL PRIMARY KEY,
    id_setor INT REFERENCES setor(id_setor) ON DELETE SET NULL,
    nome VARCHAR(100) NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    senha VARCHAR(255) NOT NULL,
    cargo VARCHAR(50) NOT NULL,
    registro VARCHAR(30),
    ativo BOOLEAN DEFAULT TRUE,
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- ============================================================
-- 5. FORNECEDOR
-- ============================================================
CREATE TABLE fornecedor (
    id_fornecedor SERIAL PRIMARY KEY,
    razao_social VARCHAR(120) NOT NULL,
    cnpj VARCHAR(18) UNIQUE,
    telefone VARCHAR(20),
    email VARCHAR(100),
    endereco VARCHAR(150),
    prazo_entrega_dias INT DEFAULT 7,
    ativo BOOLEAN DEFAULT TRUE
);

-- ============================================================
-- 6. MATERIAL
-- ============================================================
CREATE TABLE material (
    id_material SERIAL PRIMARY KEY,
    id_fornecedor INT REFERENCES fornecedor(id_fornecedor)
        ON DELETE SET NULL ON UPDATE CASCADE,
    nome VARCHAR(100) NOT NULL,
    categoria VARCHAR(50) NOT NULL,
    unidade_medida VARCHAR(20) NOT NULL,
    quantidade_minima INT DEFAULT 10,
    validade DATE,
    descricao TEXT
);

-- ============================================================
-- 7. ESTOQUE
-- ============================================================
CREATE TABLE estoque (
    id_estoque SERIAL PRIMARY KEY,
    id_material INT NOT NULL REFERENCES material(id_material)
        ON DELETE CASCADE ON UPDATE CASCADE,
    id_setor INT NOT NULL REFERENCES setor(id_setor)
        ON DELETE CASCADE ON UPDATE CASCADE,
    quantidade_atual INT DEFAULT 0,
    localizacao VARCHAR(60),
    data_atualizacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (id_material, id_setor)
);

-- ============================================================
-- 8. SOLICITACAO
-- ============================================================
CREATE TYPE prioridade_tipo AS ENUM ('Baixa','Média','Alta','Urgente');
CREATE TYPE status_tipo AS ENUM
    ('Pendente','Aprovada','Recusada','Entregue');

CREATE TABLE solicitacao (
    id_solicitacao SERIAL PRIMARY KEY,
    id_setor INT NOT NULL REFERENCES setor(id_setor),
    id_leito INT REFERENCES leito(id_leito) ON DELETE SET NULL,
    id_usuario INT NOT NULL REFERENCES usuario(id_usuario),
    id_material INT NOT NULL REFERENCES material(id_material),
    quantidade_pedida INT NOT NULL,
    prioridade prioridade_tipo DEFAULT 'Média',
    status status_tipo DEFAULT 'Pendente',
    data_solicitacao TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    observacao TEXT
);

-- ============================================================
-- 9. ALERTA
-- ============================================================
CREATE TYPE alerta_tipo AS ENUM
    ('Estoque baixo','Vencimento','Sem estoque');
CREATE TYPE alerta_nivel AS ENUM
    ('Informativo','Atenção','Crítico');

CREATE TABLE alerta (
    id_alerta SERIAL PRIMARY KEY,
    id_material INT NOT NULL REFERENCES material(id_material)
        ON DELETE CASCADE ON UPDATE CASCADE,
    id_setor INT NOT NULL REFERENCES setor(id_setor)
        ON DELETE CASCADE ON UPDATE CASCADE,
    tipo alerta_tipo NOT NULL,
    mensagem TEXT NOT NULL,
    nivel alerta_nivel DEFAULT 'Atenção',
    resolvido BOOLEAN DEFAULT FALSE,
    data_alerta TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

